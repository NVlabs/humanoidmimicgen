<mujoco model="tp_link_box">
  <default>
    <default class="visual">
      <geom group="1" contype="0" conaffinity="0" density="0"/>
    </default>
    <default class="collision">
      <geom group="0" density="500" solimp="0.95 0.98 0.001" solref="0.004 1" rgba="1 1 1 0.25"/>
    </default>
    <default class="spawn">
      <geom group="1" rgba="1 1 1 0" contype="0" conaffinity="0" density="0" mass="0"/>
    </default>
  </default>
  <asset>
    <material name="teal_mat" rgba="0.22 0.70 0.68 1" specular="0.4" shininess="0.25"/>
    <material name="navy_mat" rgba="0.08 0.18 0.55 1" specular="0.5" shininess="0.3"/>
  </asset>
  <worldbody>
    <body>
      <body name="object">
        <!-- Box dims: 13 cm x 9 cm x 9 cm  (half-extents 0.065, 0.045, 0.045) -->
        <!-- Visual: teal main body + thin navy stripes at top and bottom (tp-link look) -->
        <geom class="visual" type="box" size="0.065 0.045 0.002" pos="0 0 0.002" material="navy_mat"/>
        <geom class="visual" type="box" size="0.065 0.045 0.043" pos="0 0 0.045" material="teal_mat"/>
        <geom class="visual" type="box" size="0.065 0.045 0.002" pos="0 0 0.088" material="navy_mat"/>
        <!-- Collision: single box covering full extent -->
        <geom class="collision" type="box" size="0.065 0.045 0.045" pos="0 0 0.045"/>
        <geom class="spawn" size="0.05 0.03 0.01" type="box" pos="0 0 0.09" name="spawn_top"/>
      </body>
      <site name="bottom_site" pos="0 0 0" rgba="1 1 1 0.5" size="0.005"/>
      <site name="top_site" pos="0 0 0.09" rgba="1 1 1 0.5" size="0.005"/>
      <site name="horizontal_radius_site" pos="0.065 0.045 0" rgba="1 1 1 0.5" size="0.005"/>
    </body>
  </worldbody>
</mujoco>
