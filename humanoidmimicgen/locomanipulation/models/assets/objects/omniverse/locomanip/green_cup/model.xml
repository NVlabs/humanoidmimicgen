<mujoco model="green_cup">
  <default>
    <default class="visual">
      <geom group="1" contype="0" conaffinity="0" density="100"/>
    </default>
    <default class="collision">
      <geom group="0" density="100" solimp="0.95 0.98 0.001" solref="0.004 1" rgba="1 1 1 0.25"/>
    </default>
    <default class="spawn">
      <geom group="1" rgba="1 1 1 0" contype="0" conaffinity="0" density="0" mass="0"/>
    </default>
  </default>
  <asset>
    <texture name="green_tex" builtin="flat" rgb1="0.3 0.7 0.2" rgb2="0.3 0.7 0.2" width="32" height="32"/>
    <material name="green_mat" texture="green_tex" shininess="0.3" reflectance="0.1" rgba="0.3 0.7 0.2 1"/>
  </asset>
  <worldbody>
    <body>
      <body name="object">
        <!-- Cup body: cylinder r=0.035m, h=0.10m -->
        <geom class="collision" name="cup_body" type="cylinder" size="0.035 0.05" pos="0 0 0.05"/>
        <geom class="visual" name="cup_body_vis" type="cylinder" size="0.035 0.05" pos="0 0 0.05" material="green_mat"/>
        <!-- Spawn zone on top -->
        <geom class="spawn" name="spawn_1" type="box" size="0.02 0.02 0.001" pos="0 0 0.10"/>
      </body>
      <site name="top_site" pos="0 0 0.10" size="0.01 0.01 0.01" rgba="1 0 0 0.3"/>
      <site name="bottom_site" pos="0 0 0" size="0.01 0.01 0.01" rgba="0 1 0 0.3"/>
      <site name="horizontal_radius_site" pos="0.035 0 0.05" size="0.01 0.01 0.01" rgba="0 0 1 0.3"/>
    </body>
  </worldbody>
</mujoco>
