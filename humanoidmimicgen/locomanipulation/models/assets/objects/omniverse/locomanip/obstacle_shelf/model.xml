<mujoco model="obstacle_shelf">
  <default>
    <default class="visual">
      <geom group="1" type="box" contype="0" conaffinity="0" density="100"/>
    </default>
    <default class="collision">
      <geom group="0" type="box" density="100" solimp="0.95 0.98 0.001" solref="0.004 1" rgba="1 1 1 0.25"/>
    </default>
    <default class="spawn">
      <geom group="1" rgba="1 1 1 0" contype="0" conaffinity="0" density="0" mass="0"/>
    </default>
  </default>
  <asset>
    <texture name="black_metal_tex" builtin="flat" rgb1="0.12 0.12 0.12" rgb2="0.12 0.12 0.12" width="32" height="32"/>
    <material name="black_metal_mat" texture="black_metal_tex" shininess="0.4" reflectance="0.15" rgba="0.12 0.12 0.12 1"/>
    <texture name="brown_wood_tex" builtin="flat" rgb1="0.45 0.30 0.18" rgb2="0.50 0.33 0.20" width="32" height="32"/>
    <material name="brown_wood_mat" texture="brown_wood_tex" shininess="0.15" reflectance="0.05" rgba="0.45 0.30 0.18 1"/>
  </asset>
  <!--
    Obstacle shelf digital twin — corrected real-world measurements:
    Shelf level HEIGHTS (z from ground): 7cm, 38.5cm, 69.5cm, 163.5cm
    Shelf board width (x): 57cm, depth (y): 30cm, thickness: ~1.5cm
    Frame height: 170.5cm
    Top bar width: 30cm
    Poles: ~2.5cm diameter, at corners (~30cm x 16cm from center)
    Upper section: ladder-like cross-bars between shelves 3 (69.5cm) and 4 (163.5cm)
  -->
  <worldbody>
    <body>
      <body name="object">
        <!-- === 4 CORNER POLES (black metal, 2.5cm dia, full height 170.5cm) === -->
        <!-- Poles at ±30cm x, ±16cm y (slightly wider than shelf boards) -->
        <geom class="collision" name="pole_fl" type="cylinder" size="0.0125 0.8525" pos="-0.30 0.16 0.8525" material="black_metal_mat"/>
        <geom class="visual" name="pole_fl_vis" type="cylinder" size="0.0125 0.8525" pos="-0.30 0.16 0.8525" material="black_metal_mat"/>
        <geom class="collision" name="pole_fr" type="cylinder" size="0.0125 0.8525" pos="0.30 0.16 0.8525" material="black_metal_mat"/>
        <geom class="visual" name="pole_fr_vis" type="cylinder" size="0.0125 0.8525" pos="0.30 0.16 0.8525" material="black_metal_mat"/>
        <geom class="collision" name="pole_bl" type="cylinder" size="0.0125 0.8525" pos="-0.30 -0.16 0.8525" material="black_metal_mat"/>
        <geom class="visual" name="pole_bl_vis" type="cylinder" size="0.0125 0.8525" pos="-0.30 -0.16 0.8525" material="black_metal_mat"/>
        <geom class="collision" name="pole_br" type="cylinder" size="0.0125 0.8525" pos="0.30 -0.16 0.8525" material="black_metal_mat"/>
        <geom class="visual" name="pole_br_vis" type="cylinder" size="0.0125 0.8525" pos="0.30 -0.16 0.8525" material="black_metal_mat"/>

        <!-- === 4 BROWN WOODEN SHELF BOARDS (57cm x 30cm x 1.5cm) === -->
        <!-- Shelf 1 at z=7cm -->
        <geom class="collision" name="shelf_1" size="0.285 0.15 0.0075" pos="0 0 0.07" material="brown_wood_mat"/>
        <geom class="visual" name="shelf_1_vis" size="0.285 0.15 0.0075" pos="0 0 0.07" material="brown_wood_mat"/>
        <!-- Shelf 2 at z=38.5cm -->
        <geom class="collision" name="shelf_2" size="0.285 0.15 0.0075" pos="0 0 0.385" material="brown_wood_mat"/>
        <geom class="visual" name="shelf_2_vis" size="0.285 0.15 0.0075" pos="0 0 0.385" material="brown_wood_mat"/>
        <!-- Shelf 3 at z=69.5cm -->
        <geom class="collision" name="shelf_3" size="0.285 0.15 0.0075" pos="0 0 0.695" material="brown_wood_mat"/>
        <geom class="visual" name="shelf_3_vis" size="0.285 0.15 0.0075" pos="0 0 0.695" material="brown_wood_mat"/>
        <!-- Shelf 4 (top crossbar level) at z=163.5cm — just a bar, no board -->

        <!-- === HORIZONTAL RAILS at each shelf level (black metal, connecting poles) === -->
        <!-- Front rails (x-direction, at front y=0.16) -->
        <geom class="visual" name="rail_f_1" size="0.30 0.0125 0.0125" pos="0 0.16 0.07" material="black_metal_mat"/>
        <geom class="visual" name="rail_f_2" size="0.30 0.0125 0.0125" pos="0 0.16 0.385" material="black_metal_mat"/>
        <geom class="visual" name="rail_f_3" size="0.30 0.0125 0.0125" pos="0 0.16 0.695" material="black_metal_mat"/>
        <!-- Back rails -->
        <geom class="visual" name="rail_b_1" size="0.30 0.0125 0.0125" pos="0 -0.16 0.07" material="black_metal_mat"/>
        <geom class="visual" name="rail_b_2" size="0.30 0.0125 0.0125" pos="0 -0.16 0.385" material="black_metal_mat"/>
        <geom class="visual" name="rail_b_3" size="0.30 0.0125 0.0125" pos="0 -0.16 0.695" material="black_metal_mat"/>
        <!-- Left side rails (y-direction, at left x=-0.30) -->
        <geom class="visual" name="rail_l_1" size="0.0125 0.16 0.0125" pos="-0.30 0 0.07" material="black_metal_mat"/>
        <geom class="visual" name="rail_l_2" size="0.0125 0.16 0.0125" pos="-0.30 0 0.385" material="black_metal_mat"/>
        <geom class="visual" name="rail_l_3" size="0.0125 0.16 0.0125" pos="-0.30 0 0.695" material="black_metal_mat"/>
        <!-- Right side rails -->
        <geom class="visual" name="rail_r_1" size="0.0125 0.16 0.0125" pos="0.30 0 0.07" material="black_metal_mat"/>
        <geom class="visual" name="rail_r_2" size="0.0125 0.16 0.0125" pos="0.30 0 0.385" material="black_metal_mat"/>
        <geom class="visual" name="rail_r_3" size="0.0125 0.16 0.0125" pos="0.30 0 0.695" material="black_metal_mat"/>

        <!-- === UPPER LADDER SECTION cross-bars (between shelf 3 at 69.5cm and 163.5cm) === -->
        <!-- Left side horizontal rungs -->
        <geom class="collision" name="xbar_l_1" size="0.0125 0.16 0.0125" pos="-0.30 0 0.90" material="black_metal_mat"/>
        <geom class="visual" name="xbar_l_1_vis" size="0.0125 0.16 0.0125" pos="-0.30 0 0.90" material="black_metal_mat"/>
        <geom class="collision" name="xbar_l_2" size="0.0125 0.16 0.0125" pos="-0.30 0 1.10" material="black_metal_mat"/>
        <geom class="visual" name="xbar_l_2_vis" size="0.0125 0.16 0.0125" pos="-0.30 0 1.10" material="black_metal_mat"/>
        <geom class="collision" name="xbar_l_3" size="0.0125 0.16 0.0125" pos="-0.30 0 1.30" material="black_metal_mat"/>
        <geom class="visual" name="xbar_l_3_vis" size="0.0125 0.16 0.0125" pos="-0.30 0 1.30" material="black_metal_mat"/>
        <geom class="collision" name="xbar_l_4" size="0.0125 0.16 0.0125" pos="-0.30 0 1.50" material="black_metal_mat"/>
        <geom class="visual" name="xbar_l_4_vis" size="0.0125 0.16 0.0125" pos="-0.30 0 1.50" material="black_metal_mat"/>
        <!-- Right side horizontal rungs -->
        <geom class="collision" name="xbar_r_1" size="0.0125 0.16 0.0125" pos="0.30 0 0.90" material="black_metal_mat"/>
        <geom class="visual" name="xbar_r_1_vis" size="0.0125 0.16 0.0125" pos="0.30 0 0.90" material="black_metal_mat"/>
        <geom class="collision" name="xbar_r_2" size="0.0125 0.16 0.0125" pos="0.30 0 1.10" material="black_metal_mat"/>
        <geom class="visual" name="xbar_r_2_vis" size="0.0125 0.16 0.0125" pos="0.30 0 1.10" material="black_metal_mat"/>
        <geom class="collision" name="xbar_r_3" size="0.0125 0.16 0.0125" pos="0.30 0 1.30" material="black_metal_mat"/>
        <geom class="visual" name="xbar_r_3_vis" size="0.0125 0.16 0.0125" pos="0.30 0 1.30" material="black_metal_mat"/>
        <geom class="collision" name="xbar_r_4" size="0.0125 0.16 0.0125" pos="0.30 0 1.50" material="black_metal_mat"/>
        <geom class="visual" name="xbar_r_4_vis" size="0.0125 0.16 0.0125" pos="0.30 0 1.50" material="black_metal_mat"/>

        <!-- === SHELF 4 at z=163.5cm (brown wooden board, same as others) === -->
        <geom class="collision" name="shelf_4" size="0.285 0.15 0.0075" pos="0 0 1.635" material="brown_wood_mat"/>
        <geom class="visual" name="shelf_4_vis" size="0.285 0.15 0.0075" pos="0 0 1.635" material="brown_wood_mat"/>
        <geom class="collision" name="top_bar" size="0.15 0.0125 0.0125" pos="0 0 1.705" material="black_metal_mat"/>
        <geom class="visual" name="top_bar_vis" size="0.15 0.0125 0.0125" pos="0 0 1.705" material="black_metal_mat"/>

        <!-- Spawn zones (between shelves) -->
        <geom class="spawn" name="spawn_1" type="box" size="0.25 0.13 0.12" pos="0 0 0.225"/>
        <geom class="spawn" name="spawn_2" type="box" size="0.25 0.13 0.12" pos="0 0 0.54"/>
      </body>
      <site name="top_site" pos="0 0 1.705" size="0.01 0.01 0.01" rgba="1 0 0 0.3"/>
      <site name="bottom_site" pos="0 0 0" size="0.01 0.01 0.01" rgba="0 1 0 0.3"/>
      <site name="horizontal_radius_site" pos="0.30 0.16 0.8525" size="0.01 0.01 0.01" rgba="0 0 1 0.3"/>
    </body>
  </worldbody>
</mujoco>
